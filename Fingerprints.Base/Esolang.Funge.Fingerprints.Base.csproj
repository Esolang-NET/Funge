<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>Esolang.Funge.Fingerprints.Base</RootNamespace>
    <Description>BASE fingerprint (0x42415345) for Funge-98: Base conversion functions via IFingerprint.</Description>
    <PackageId>Esolang.Funge.Fingerprints.Base</PackageId>
    <PackageTags>esolang;funge;funge-98;befunge;fingerprints;base</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Abstractions/Esolang.Funge.Abstractions.csproj" />
  </ItemGroup>
</Project>
