<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>Esolang.Funge.Fingerprints.Fpdp</RootNamespace>
    <Description>FPDP fingerprint (0x46504450) for Funge-98: double precision floating point A B C D E F G H I K L M N P Q S T V X Y.</Description>
    <PackageId>Esolang.Funge.Fingerprints.Fpdp</PackageId>
    <PackageTags>esolang;funge;funge-98;befunge;fingerprints;fpdp</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Abstractions/Esolang.Funge.Abstractions.csproj" />
  </ItemGroup>
</Project>
