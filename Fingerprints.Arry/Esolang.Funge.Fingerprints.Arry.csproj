<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>Esolang.Funge.Fingerprints.Arry</RootNamespace>
    <Description>ARRY fingerprint (0x41525259) for Funge-98: funge-space backed array functions via IFingerprint.</Description>
    <PackageId>Esolang.Funge.Fingerprints.Arry</PackageId>
    <PackageTags>esolang;funge;funge-98;befunge;fingerprints;arry;array</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Abstractions/Esolang.Funge.Abstractions.csproj" />
  </ItemGroup>
</Project>
